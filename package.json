{
  "name": "signal-outpost-cps",
  "version": "1.0.5",
  "description": "Offline desktop codeplug programmer for Signal Outpost DM-32UV firmware",
  "author": "KQ4ESZ",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "main": "src/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kq4esz/SignalOutpost.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "release": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.signaloutpost.cps",
    "productName": "Signal Outpost CPS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/cps",
        "to": "cps"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "artifactName": "Signal-Outpost-CPS-${version}-${arch}-Setup.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Signal Outpost CPS",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kq4esz",
        "repo": "SignalOutpost",
        "releaseType": "release"
      }
    ]
  }
}
